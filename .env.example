# Copy to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never put the service-role / secret key in a NEXT_PUBLIC_ variable.

# Optional: public URL of the deployment, used for absolute link-preview
# image URLs. On Vercel the production URL is detected automatically.
# SITE_URL=https://your-domain.example
